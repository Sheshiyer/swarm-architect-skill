{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swarm Architect Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "area",
    "owner_role",
    "est_hours",
    "dependencies",
    "deliverable",
    "acceptance",
    "validation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable task identifier, e.g. T-001"
    },
    "title": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "enum": ["frontend", "backend", "data", "infra", "qa", "product"]
    },
    "owner_role": {
      "type": "string"
    },
    "owner_agent": {
      "type": "string",
      "description": "Primary coding or orchestration agent"
    },
    "execution_profile": {
      "type": "string",
      "description": "Specialist execution overlay, e.g. agency/frontend-developer"
    },
    "quality_profile": {
      "type": "string",
      "description": "Quality methodology overlay, e.g. impeccable/polish"
    },
    "validation_profile": {
      "type": "string",
      "description": "Validation overlay, e.g. agency/reality-checker"
    },
    "memory_scope": {
      "type": "string",
      "enum": ["project", "planning", "phase", "wave", "swarm", "task", "validation", "lesson"]
    },
    "memory_uri": {
      "type": "string",
      "description": "Primary OpenViking URI for this task or planning object"
    },
    "memory_inputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "OpenViking URIs or other memory references that should be loaded before work starts"
    },
    "memory_outputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Named records or URIs that should be written after completion"
    },
    "phase": {
      "type": "string"
    },
    "wave": {
      "type": "string"
    },
    "swarm": {
      "type": "string"
    },
    "est_hours": {
      "type": "number",
      "minimum": 0
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deliverable": {
      "type": "string"
    },
    "acceptance": {
      "type": "string"
    },
    "validation": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "lock_zone": {
      "type": "boolean"
    },
    "copilot_eligible": {
      "type": "boolean",
      "default": false,
      "description": "When true, the planner marks this task as safe to route to the GitHub Copilot coding agent (copilot-swe-agent[bot]). Requires a well-scoped deliverable, explicit acceptance criteria, a concrete files-of-interest list, and one-branch/one-PR scope. See playbooks/copilot-coding-agent.md."
    },
    "copilot_role": {
      "type": "string",
      "enum": ["frontend", "backend", "data", "infra", "qa", "product"],
      "description": "Optional hint for path-scoped instructions in the target repo. Maps to a .github/instructions/<role>.instructions.md file when one exists."
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
